# Sourced by every bin/*.sh script and every SLURM job.  EDIT FOR YOUR CLUSTER.
# ---------------------------------------------------------------------------
# Where the full vetted NEID L2 solar data lives *as seen from compute nodes*.
# Penn State Roar: the curated p-mode-averaged set. Used when that directory is visible;
# elsewhere (this development container) the sample files are used.
_ROAR_DATA=/storage/home/jpn23/scratch/Pmode_averaged_solar_datav1.5ForAgents
if [ -z "${NEID_DATA_DIR:-}" ]; then
  if [ -d "$_ROAR_DATA" ]; then export NEID_DATA_DIR="$_ROAR_DATA"; else export NEID_DATA_DIR=/workspace/NEIDData; fi
fi
# Where the compact store is written (needs roughly 0.15 GB per observing day).
export RVSWARM_STORE="${RVSWARM_STORE:-}"            # empty -> data_store/main under the repo
# Python used by harness jobs.  Either point at an interpreter ...
# ... or activate an environment. On Roar: the conda environment used for this project.
# (Installed with: pip install -r requirements-cluster.txt, plus `anthropic` if the
# orchestrator runs from the same environment.)
_ROAR_ENV=/storage/home/jpn23/work/pyENV4RVSWARM
if [ -z "${RVSWARM_PYTHON:-}" ] && [ -d "$_ROAR_ENV" ]; then
  module load anaconda3 2>/dev/null || true
  conda activate "$_ROAR_ENV" 2>/dev/null || export PATH="$_ROAR_ENV/bin:$PATH"
  export RVSWARM_PYTHON="$_ROAR_ENV/bin/python"
fi
export RVSWARM_PYTHON="${RVSWARM_PYTHON:-}"          # empty -> .venv/bin/python under the repo
# Scratch space for algorithm caches during a job (can need tens of GB; node-local is best).
export RVSWARM_SCRATCH="${RVSWARM_SCRATCH:-}"      # empty -> state/scratch under the repo
# SLURM settings
export RVSWARM_SBATCH_ACCOUNT="${RVSWARM_SBATCH_ACCOUNT:-sqm107_b}"       # Roar allocation
export RVSWARM_SBATCH_PARTITION="${RVSWARM_SBATCH_PARTITION:-sla-prio}"   # or: open, burst
# GPU jobs: UNVERIFIED -- set to whatever partition/allocation gives you GPUs on Roar.
export RVSWARM_SBATCH_GPU_PARTITION="${RVSWARM_SBATCH_GPU_PARTITION:-sla-prio}"
export RVSWARM_SBATCH_GPU_FLAG="${RVSWARM_SBATCH_GPU_FLAG:---gpus=1}"
# Extra sbatch flags, as in your usual Roar job scripts. Add e.g.
#   --mail-type=FAIL --mail-user=<you>@psu.edu
# if you want a mail per failed job (one evaluation = one job, so this can be many mails).
export RVSWARM_SBATCH_EXTRA="${RVSWARM_SBATCH_EXTRA:---get-user-env --open-mode=append}"
# REQUIRED containment wrapper for algorithm code (RUNBOOK section 10).  The static audit
# alone can be bypassed by determined code, so real-data evaluations refuse to run without
# a container that hides secrets/ and state/ from the algorithm process.  The harness
# substitutes $RVSWARM_RUN_WORK (per-run work dir, must be writable), $RVSWARM_RUN_SNAP
# (code snapshot) and $RVSWARM_HARNESS_DIR before running it.  Template -- adapt and test:
#   export RVSWARM_SANDBOX_CMD='apptainer exec --containall --no-home --net --network none --nv
#     --bind $RVSWARM_HARNESS_DIR:$RVSWARM_HARNESS_DIR:ro --bind $RVSWARM_RUN_SNAP:$RVSWARM_RUN_SNAP:ro
#     --bind $RVSWARM_RUN_WORK:$RVSWARM_RUN_WORK --bind /path/to/store:/path/to/store:ro
#     --bind /path/to/NEID/L2:/path/to/NEID/L2:ro /path/to/rvswarm_env.sif'
export RVSWARM_SANDBOX_CMD="${RVSWARM_SANDBOX_CMD:-}"
# Set to 1 only to knowingly run algorithm code un-contained (plumbing tests, first checks).
export RVSWARM_ALLOW_UNSANDBOXED="${RVSWARM_ALLOW_UNSANDBOXED:-0}"
